class Solution {
    public String[] assignUmbrella(int[] rain) {
        String[] ans=new String[rain.length];
        int alice=0;
        int bob=0;
        for(int i=0;i<rain.length-1;i++){
            if(i<rain.length-1 && rain[i]==1 && rain[i+1]==1){
                if(alice<=bob){
                    ans[i]="Alice";
                    alice++;
                }else{
                    ans[i]="Bob";
                    bob++;
                }
            }else if(rain[i]==1 ){
                ans[i]="Bob";
                bob++;
            }else{
                ans[i]="None";
            }
        }
        if(rain[rain.length-1]==1){
            ans[rain.length-1]="Bob";
        }
        else{
            ans[rain.length-1]="None";
            }
        return ans;
    }
}©leetcode
