class Solution {
    public double average(int[] salary) {
        int max=Integer.MIN_VALUE;
        int min=Integer.MAX_VALUE;
        for(int i=0;i<salary.length;i++){
            if(max<salary[i]){
                max=salary[i];
            }if(min>salary[i]){
                min=salary[i];
            }
        }
        int count=0;
        int sum=0;
        for(int i=0;i<salary.length;i++){
            if(salary[i]!=max && salary[i]!=min){
                sum+=salary[i];
                count++;
            }
        }
        double avg=(double)sum/count;
        return avg;
    }
}
