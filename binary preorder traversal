class Solution {
    List<Integer> result;
    public List<Integer> preorderTraversal(TreeNode root) {
        result=new ArrayList<>();
        preorder(root);
        return result;

     }
    
     void preorder(TreeNode root){
        if(root==null){
            return;
        }
        result.add(root.val);
        preorder(root.left);
        preorder(root.right);
}
}
