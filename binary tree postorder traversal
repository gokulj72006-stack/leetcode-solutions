class Solution {
    List<Integer>result;
    public List<Integer> postorderTraversal(TreeNode root) {
        result=new ArrayList<>();
        postorder(root);
        return result; 
    }
    void postorder(TreeNode root){
        if(root==null){
            return;
        }
        postorder(root.left);
        postorder(root.right);
        result.add(root.val);
    }
}
