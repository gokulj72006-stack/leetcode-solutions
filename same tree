class Solution {
    List<Integer> ans;
    List<Integer> an;

    public boolean isSameTree(TreeNode p, TreeNode q) {
        ans = new ArrayList<>();
        an = new ArrayList<>();
        preorder(p, ans);
        preorder(q, an);
        return ans.equals(an);
    }

    void preorder(TreeNode node, List<Integer> list) {
        if (node == null) {
            list.add(null);   // record nulls so the shape is captured
            return;
        }
        list.add(node.val);
        preorder(node.left, list);
        preorder(node.right, list);
    }
}
