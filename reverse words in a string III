class Solution {
    public String reverseWords(String s) {
        char ch[]=new char[s.length()];
        for(int i=0;i<s.length();i++){
            ch[i]=s.charAt(i);
        }
         int start=0;
        for(int i=0;i<=ch.length;i++){
            if(s.length()==i || ch[i]==' '){
                int left=start,right=i-1;
                while(left<right){
                    char temp=ch[left];
                    ch[left]=ch[right];
                    ch[right]=temp;
                    left++;
                    right--;
                }
                  start=i+1;

            }
        }
        return (new String(ch));
    }
}
